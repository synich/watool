# snip_win_c
// default is A(char, ""); define UNICODE and _UNICODE to W(wchar_t, L"")
#include <windows.h>
#include <stdio.h>

// 控件ID与命令ID定义
#define ID_COMBOBOX      1001
#define ID_EDIT_MIDDLE   1002
#define ID_EDIT_BOTTOM   1003
#define ID_CHECKBOX      1004
#define ID_LISTBOX       1005
#define IDM_CTRL_R       2001  // Ctrl+R 的命令ID
#define countof(a)    (sizeof(a)/sizeof((a)[0]))

// 全局句柄
HWND g_hCombo;
HWND g_hEditInput;
HWND g_hEditOutput;
HWND g_hCheck;
HWND g_hList;

void bussCode(TCHAR* comboText, TCHAR* midText, int isChecked, int index){
    TCHAR result[4096] = { 0 };
    _snprintf(result, countof(result), TEXT("%s,%d,%d:%s"), comboText, isChecked, index, midText);
    SetWindowText(g_hEditOutput, result);
}

// GUI参数转业务逻辑
static void BrgGui2Buss(void)
{
    // 获取每个控件的值
    TCHAR comboText[256] = { 0 };
    int sel = (int)SendMessage(g_hCombo, CB_GETCURSEL, 0, 0);
    if (sel != CB_ERR) { SendMessage(g_hCombo, CB_GETLBTEXT, sel, (LPARAM)comboText); }
    int isChecked = (SendMessage(g_hCheck, BM_GETCHECK, 0, 0) == BST_CHECKED);
    int index = SendMessage(g_hList, LB_GETCURSEL, 0, 0);
    int midLen = GetWindowTextLength(g_hEditInput);
    TCHAR* midText = (TCHAR*)GlobalAlloc(GPTR, (midLen + 1) * sizeof(TCHAR));
    if (midText) {
        GetWindowText(g_hEditInput, midText, midLen + 1);
        bussCode(comboText, midText, isChecked, index);
        GlobalFree(midText);
    }
}

int msg_loop() {
    MSG msg;
    while (GetMessage(&msg, NULL, 0, 0)) {
        if (msg.message == WM_KEYDOWN){ // choose your favor
            if ((GetKeyState(VK_CONTROL) & 0x8000) && (msg.wParam == 'R')) {
                BrgGui2Buss();
                continue;
            }
        }
        TranslateMessage(&msg);
        DispatchMessage(&msg);
    }
    return (int)msg.wParam;
}

LRESULT CALLBACK WndProc(HWND, UINT, WPARAM, LPARAM);

int WINAPI WinMain(HINSTANCE hInstance, HINSTANCE hPrevInstance, LPSTR lpCmdLine, int nCmdShow)
{
    WNDCLASSEX wc = { 0 };
    wc.cbSize        = sizeof(WNDCLASSEX);
    wc.style         = CS_HREDRAW | CS_VREDRAW;
    wc.lpfnWndProc   = WndProc;
    wc.hInstance     = hInstance;
    wc.hCursor       = LoadCursor(NULL, IDC_ARROW);
    wc.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);
    wc.lpszClassName = TEXT("MyWin32App");
    RegisterClassEx(&wc);

    DWORD dwStyle = WS_OVERLAPPEDWINDOW;
    RECT rc = { 0, 0, 800, 600 };
    AdjustWindowRect(&rc, dwStyle, FALSE);
    HWND hWnd = CreateWindow(
        TEXT("MyWin32App"), TEXT("Win32 Demo"),
        dwStyle,
        CW_USEDEFAULT, CW_USEDEFAULT,
        rc.right - rc.left, rc.bottom - rc.top,
        NULL, NULL, hInstance, NULL
    );

    ShowWindow(hWnd, nCmdShow);
    UpdateWindow(hWnd);
    return msg_loop(hWnd);
}

static void layout_win(HWND hWnd)
{
    // ========== 第一行：Label + ComboBox + CheckBox ==========
    // 1. Label "Ctrl+R"
    CreateWindow(TEXT("STATIC"), TEXT("Ctrl+R"),
        WS_CHILD | WS_VISIBLE | SS_CENTERIMAGE,
        10, 10, 60, 25,
        hWnd, NULL, NULL, NULL);

    // 2. ComboBox
    g_hCombo = CreateWindow(TEXT("COMBOBOX"), TEXT(""),
        WS_CHILD | WS_VISIBLE | CBS_DROPDOWNLIST | WS_VSCROLL,
        80, 8, 100, 200, // 宽度稍微减小以腾出空间给 CheckBox
        hWnd, (HMENU)ID_COMBOBOX, NULL, NULL);

    SendMessage(g_hCombo, CB_ADDSTRING, 0, (LPARAM)TEXT("A"));
    SendMessage(g_hCombo, CB_ADDSTRING, 0, (LPARAM)TEXT("B"));
    SendMessage(g_hCombo, CB_ADDSTRING, 0, (LPARAM)TEXT("C"));
    SendMessage(g_hCombo, CB_SETCURSEL, 0, 0);

    // 3. CheckBox 使用 BS_AUTOCHECKBOX，点击时系统自动切换勾选状态
    g_hCheck = CreateWindow(TEXT("BUTTON"), TEXT("Enable"),
        WS_CHILD | WS_VISIBLE | BS_AUTOCHECKBOX,
        190, 12, 100, 20, // x=190, y=12
        hWnd, (HMENU)ID_CHECKBOX, NULL, NULL);

    // 4. ListBox 放在右侧下方，占据一部分空间
    g_hList = CreateWindow(TEXT("LISTBOX"), TEXT(""),
        WS_CHILD | WS_VISIBLE | WS_BORDER | LBS_NOTIFY | WS_VSCROLL,
        300, 8, 150, 60, // x=300, y=8, 宽150, 高60
        hWnd, (HMENU)ID_LISTBOX, NULL, NULL);

    // 初始化 ListBox 内容
    SendMessage(g_hList, LB_ADDSTRING, 0, (LPARAM)TEXT("Item 1"));
    SendMessage(g_hList, LB_ADDSTRING, 0, (LPARAM)TEXT("Item 2"));
    SendMessage(g_hList, LB_ADDSTRING, 0, (LPARAM)TEXT("Item 3"));
    SendMessage(g_hList, LB_SETCURSEL, 0, 0); // 默认选中第一项

    // ========== 中间多行文本框 (~1/3 剩余空间) ==========
    g_hEditInput = CreateWindow(TEXT("EDIT"), TEXT(""),
        WS_CHILD | WS_VISIBLE | WS_BORDER | ES_MULTILINE |
        ES_AUTOVSCROLL | WS_VSCROLL | ES_WANTRETURN,
        10, 85, 780, 160,
        hWnd, (HMENU)ID_EDIT_MIDDLE, NULL, NULL);

    // ========== 下面多行文本框 (~2/3 剩余空间) ==========
    g_hEditOutput = CreateWindow(TEXT("EDIT"), TEXT(""),
        WS_CHILD | WS_VISIBLE | WS_BORDER | ES_MULTILINE |
        ES_AUTOVSCROLL | WS_VSCROLL | ES_WANTRETURN,
        10, 255, 780, 335,
        hWnd, (HMENU)ID_EDIT_BOTTOM, NULL, NULL);
}

LRESULT CALLBACK WndProc(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam)
{
    switch (msg) {
    case WM_CREATE: {
        layout_win(hWnd);
        break;
    }

    case WM_DESTROY:
        PostQuitMessage(0);
        break;

    default:
        return DefWindowProc(hWnd, msg, wParam, lParam);
    }
    return 0;
}
@@

# snip_win_rc
#ifndef RESOURCE_H
#define RESOURCE_H

#define IDD_MAIN_DIALOG     101
#define IDC_STATIC          1000
#define ID_COMBOBOX         1001
#define ID_EDIT_MIDDLE      1002
#define ID_EDIT_BOTTOM      1003
#define ID_BTN_CONCAT       1004  // 新增按钮ID

#endif  //resource.h

// -lcomctl32
#include <windows.h>
#include <commctrl.h>
#include <stdio.h>
#include "resource.h"

// 全局句柄
HWND g_hCombo;
HWND g_hEditMiddle;
HWND g_hEditBottom;

// 对话框过程声明
INT_PTR CALLBACK DialogProc(HWND, UINT, WPARAM, LPARAM);

int WINAPI WinMain(HINSTANCE hInstance, HINSTANCE hPrevInstance, LPSTR lpCmdLine, int nCmdShow)
{
    // 使用 DialogBoxParam 启动模态对话框 最后一个参数 lParam 可以传递自定义数据，这里暂时传 NULL
    INT_PTR result = DialogBoxParam(hInstance, MAKEINTRESOURCE(IDD_MAIN_DIALOG), NULL, DialogProc, 0);
    return (int)result;
}

static void BrgGui2Buss(void)
{
    if (!g_hCombo || !g_hEditMiddle || !g_hEditBottom) return;

    TCHAR comboText[256] = { 0 };
    int sel = (int)SendMessage(g_hCombo, CB_GETCURSEL, 0, 0);
    if (sel != CB_ERR) {
        SendMessage(g_hCombo, CB_GETLBTEXT, sel, (LPARAM)comboText);
    }

    int midLen = GetWindowTextLength(g_hEditMiddle);
    // 分配内存获取中间文本框内容
    TCHAR* midText = (TCHAR*)GlobalAlloc(GPTR, (midLen + 1) * sizeof(TCHAR));
    if (midText) {
        GetWindowText(g_hEditMiddle, midText, midLen + 1);
        TCHAR result[4096] = { 0 };
        // 拼接字符串
        _snprintf(result, _countof(result), TEXT("%s%s"), comboText, midText);
        // 输出到下方文本框
        SetWindowText(g_hEditBottom, result);
        GlobalFree(midText);
    }
}

// ========== 编辑框子类化过程 (拦截按键) ==========
LRESULT CALLBACK EditSubclassProc(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam, UINT_PTR uIdSubclass, DWORD_PTR dwRefData)
{
    switch (uMsg) {
    case WM_KEYDOWN:
        // 检测 Ctrl + R
        if (wParam == 'R' && (GetKeyState(VK_CONTROL) & 0x8000)) {
            BrgGui2Buss();
            return 0; // 拦截成功，不再传递给默认编辑框处理
        }
        break;

    case WM_NCDESTROY:
        // 清理子类化
        RemoveWindowSubclass(hWnd, EditSubclassProc, uIdSubclass);
        break;
    }

    // 其他消息交给默认处理
    return DefSubclassProc(hWnd, uMsg, wParam, lParam);
}

INT_PTR CALLBACK DialogProc(HWND hDlg, UINT msg, WPARAM wParam, LPARAM lParam)
{
    switch (msg) {
    case WM_INITDIALOG: {
        // ========== 初始化控件 ==========
        g_hCombo = GetDlgItem(hDlg, ID_COMBOBOX);
        g_hEditMiddle = GetDlgItem(hDlg, ID_EDIT_MIDDLE);
        g_hEditBottom = GetDlgItem(hDlg, ID_EDIT_BOTTOM);

        // 填充 ComboBox 选项
        SendMessage(g_hCombo, CB_ADDSTRING, 0, (LPARAM)TEXT("1"));
        SendMessage(g_hCombo, CB_ADDSTRING, 0, (LPARAM)TEXT("2"));
        SendMessage(g_hCombo, CB_ADDSTRING, 0, (LPARAM)TEXT("3"));
        SendMessage(g_hCombo, CB_SETCURSEL, 0, 0); // 默认选中第一项
        // 【关键步骤】为中间编辑框安装子类化钩子
        // 这样即使焦点在编辑框里，也能捕获 Ctrl+R
        SetWindowSubclass(g_hEditMiddle, EditSubclassProc, 0, 0);
        // SetWindowSubclass(g_hEditBottom, EditSubclassProc, 1, 0);

        return TRUE; // 返回 TRUE 表示已处理焦点设置
    }

    case WM_COMMAND: {
        int wmId = LOWORD(wParam);
        int wmEvent = HIWORD(wParam);

        // 处理按钮点击
        if (wmId == ID_BTN_CONCAT && wmEvent == BN_CLICKED) {
            BrgGui2Buss();
            return TRUE;
        }

        // 处理关闭/取消按钮 (DialogBox 默认会处理 IDCANCEL)
        if (wmId == IDCANCEL || wmId == IDOK) {
            EndDialog(hDlg, 0);
            return TRUE;
        }
        break;
    }

    case WM_CLOSE:
        EndDialog(hDlg, 0);
        return TRUE;
    }
    return FALSE;
}
