# snip_bat
-- syn --
setlocal EnableDelayedExpansion

if "%~1" == "" (
  echo usage
  exit /b %errorlevel%
)

rem call like fork, must with %* and (goto or exit)
if "%1" == "f" (
  shift  rem %* drop %1(f)
  call :main %*
  exit /b %errorlevel%
)

rem def use goto to end(exit is ok, just favorite)
:main
  for /f "delims=" %%I in ('fzf') do (
    set "sel_file=%%I"
  )
  if not defined sel_file (
    echo no file
    goto :end
  )
rem !var! is special with for
  npp !sel_file!
  goto :end

:end
rem must end avoid exception
endlocal
@@

